# CareTwin AI — server-side configuration example.
# Copy to .env (project root) or apps/api/.env and fill in real values.
# NEVER commit .env, and never expose these values to the browser (no NEXT_PUBLIC_ prefix).

# --- Application / runtime ---
CARETWIN_ENV=development
CARETWIN_LOG_LEVEL=INFO
CARETWIN_DEMO_MODE=true
CARETWIN_SEED_DEMO=true
CARETWIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (SQLite local/demo default; PostgreSQL recommended for production, not live-verified in-repo) ---
CARETWIN_DATABASE_BACKEND=sqlite
# CARETWIN_DATABASE_URL=postgresql://user:password@host:5432/caretwin
CARETWIN_DB_PATH=data/demo/caretwin.db
CARETWIN_DB_POOL_SIZE=5

# --- Document storage (local private default; object-storage adapter config is not live-verified) ---
CARETWIN_STORAGE_BACKEND=local
CARETWIN_DOCUMENT_STORAGE_PATH=data/documents
# CARETWIN_STORAGE_BUCKET=
# CARETWIN_STORAGE_PREFIX=
CARETWIN_MAX_UPLOAD_BYTES=15728640
CARETWIN_MAX_PDF_PAGES=50

# --- Encryption / key management (provide keys via secret manager in production; never commit real keys) ---
# Document-at-rest encryption hook; enable fail-closed in production only with a validated key/strategy.
CARETWIN_REQUIRE_DOCUMENT_ENCRYPTION=false
# CARETWIN_DOCUMENT_ENCRYPTION_KEY=
# Backup artifact encryption (Fernet key, base64 urlsafe 32-byte key).
# CARETWIN_BACKUP_ENCRYPTION_KEY=
CARETWIN_BACKUP_ROOT_PATH=data/backups
CARETWIN_BACKUP_RETENTION_COUNT=14

# --- Rate limiting (memory default; shared store not live-verified without real service) ---
CARETWIN_RATE_LIMIT_BACKEND=memory
# CARETWIN_RATE_LIMIT_STORE_URL=redis://host:6379/0
CARETWIN_UPLOAD_REQUESTS_PER_HOUR=200
CARETWIN_ASSISTANT_REQUESTS_PER_HOUR=120

# --- Authentication (demo default; production requires verified OIDC config and never accepts demo headers) ---
CARETWIN_AUTH_MODE=demo
# CARETWIN_AUTH_ISSUER=https://issuer.example
# CARETWIN_AUTH_AUDIENCE=caretwin-api
# CARETWIN_AUTH_JWKS_URL=https://issuer.example/.well-known/jwks.json
# CARETWIN_AUTH_ALGORITHMS=RS256,RS384,RS512,ES256
# CARETWIN_AUTH_CLIENT_ID=
# CARETWIN_AUTH_CLIENT_SECRET=
# CARETWIN_AUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
# CARETWIN_AUTH_POST_LOGIN_REDIRECT=/workspace
# CARETWIN_AUTH_COOKIE_SECURE=false
# CARETWIN_AUTH_SESSION_TTL_SECONDS=28800
# CARETWIN_AUTH_SESSION_IDLE_SECONDS=3600

# --- Gemini (optional; deterministic mode is used when unset) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
CARETWIN_AI_MODEL=gemini-3.8-flash
CARETWIN_AI_PROVIDER=gemini
CARETWIN_AI_API_BASE=https://generativelanguage.googleapis.com/v1beta
CARETWIN_AI_TIMEOUT_SECONDS=40
CARETWIN_AI_MAX_INPUT_CHARS=24000
CARETWIN_AI_MAX_OUTPUT_TOKENS=3072
CARETWIN_AI_REQUESTS_PER_HOUR=40
CARETWIN_AI_RETRY_ATTEMPTS=2

# --- Document extraction ---
# Optional explicit Tesseract binary; auto-detected on Windows otherwise.
# CARETWIN_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
